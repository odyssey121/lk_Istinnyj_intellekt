{
  "name": "true-intelligence",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "build": "npm run build -w apps/api && npm run build -w apps/web",
    "typecheck": "tsc -p apps/api/tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "test": "DATABASE_URL=${TEST_DATABASE_URL:-postgresql://intelligence:intelligence@localhost:54329/intelligence_test} npm run test -w apps/api",
    "mock": "tsx mock/server.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "bcryptjs": "^3.0.2"
  },
  "devDependencies": {
    "prisma": "6.19.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "@types/node": "^22.0.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "effect": "^3.20.0"
  }
}
